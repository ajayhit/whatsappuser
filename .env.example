NODE_ENV=production
SESSION_DIR=./sessions
DB_PATH=./database.db
# PostgreSQL online connection string (e.g. Neon, Supabase, Render PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# CRITICAL SECURITY: Secret key used to sign JWT authentication tokens. Change to a strong random 64-char string.
JWT_SECRET=replace_with_a_secure_random_64_character_jwt_secret_key
